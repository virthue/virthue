{
  "name": "virthue",
  "version": "1.0.0",
  "description": "virtual hue bridge",
  "keywords": [
    "Hue",
    "virthue",
    "Philips Hue",
    "Hue Bridge",
    "Emulator"
  ],
  "license": "MIT",
  "author": "Adrian Preuß",
  "homepage": "https://github.com/virthue/virthue/",
  "repository": {
    "type": "git",
    "url": "https://github.com/virthue/virthue/issues.git"
  },
  "bugs": {
    "url": "https://github.com/virthue/virthue/issues"
  },
  "type": "module",
  "main": "src/main.js",
  "node-main": "src/main.js",
  "window": {
    "show": false,
    "frame": false
  },
  "scripts": {
    "start": "electron .",
    "run": "node .",
    "build:all": "npm run build:licenses && npm run build:icons && npm run build:swagger",
    "build:licenses": "node ./bin/build/licenses.js",
    "build:icons": "node ./bin/build/icons.js",
    "build:swagger": "node ./bin/build/swagger.js",
    "test:csr": "node ./tests/cert/csr.js",
    "test:provisioning": "node ./tests/cert/provisioning.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.2",
    "@peculiar/x509": "^2.0.0",
    "chalk": "^6.0.0",
    "chalk-template": "^1.1.2",
    "fastify": "^5.6.2",
    "fastify-sse-v2": "^4.2.1",
    "mdns-js": "^1.0.3",
    "node-forge": "^1.4.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "selfsigned": "^5.5.0",
    "stacktrace-js": "^2.0.2",
    "svg2img": "^1.0.0-beta.2"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "svg-to-ico": "^2.0.0"
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "sharp@0.34.5": true
  }
}
